{
  "name": "dsh-credentials-center",
  "version": "0.3.0",
  "description": "One place for every API credential DeepSeek Harness and its plugins use: every reference (env name) the model routes, media APIs, web search, desktop pet, memory embeddings and cost meter point at, whether it is configured and where it is stored, which features are bound to it, an owner-given alias/note, and set / replace / delete — through the core credential store, never a plain file.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@dsh-suite/kit": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WZZNNE/DSH-CyberWorkStation.git",
    "directory": "plugins/dsh-credentials-center"
  },
  "homepage": "https://github.com/WZZNNE/DSH-CyberWorkStation#readme",
  "bugs": {
    "url": "https://github.com/WZZNNE/DSH-CyberWorkStation/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-cyberworkstation"
  ],
  "publishConfig": {
    "access": "public"
  }
}
