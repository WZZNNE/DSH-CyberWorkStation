{
  "name": "dsh-control-deck",
  "version": "0.3.1",
  "description": "Control Deck for DeepSeek Harness: leveled system-prompt entries (roles, intervals, macros), regex scripts (user input / world info / display-only AI output), World Info lorebooks with the full SillyTavern field set, sampling overrides with a master switch, tool disable switches, presets and SillyTavern JSON import/export. Edited on the DSH Launcher Control Deck page or in ~/.dsh/control-deck.json; reloaded live.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-home-paths": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WZZNNE/DSH-CyberWorkStation.git",
    "directory": "plugins/dsh-control-deck"
  },
  "homepage": "https://github.com/WZZNNE/DSH-CyberWorkStation#readme",
  "bugs": {
    "url": "https://github.com/WZZNNE/DSH-CyberWorkStation/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-cyberworkstation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dsh-cyberworkstation-kit": "^1.0.0"
  }
}
