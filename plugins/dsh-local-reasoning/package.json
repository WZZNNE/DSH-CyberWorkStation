{
  "name": "dsh-local-reasoning",
  "version": "0.1.1",
  "description": "Per-model context window, max output and thinking levels for every DeepSeek Harness route (DeepSeek official, OpenRouter, local LM Studio / Ollama); probes local backends and teaches their levels; OpenRouter :online web-search variants. Edited on the DSH Launcher Model parameters page or through its routes and ~/.dsh/local-reasoning.json.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-home-paths": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WZZNNE/DSH-CyberWorkStation.git",
    "directory": "plugins/dsh-local-reasoning"
  },
  "homepage": "https://github.com/WZZNNE/DSH-CyberWorkStation#readme",
  "bugs": {
    "url": "https://github.com/WZZNNE/DSH-CyberWorkStation/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-cyberworkstation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dsh-cyberworkstation-kit": "^1.0.0"
  }
}
