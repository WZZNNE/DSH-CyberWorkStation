{
  "name": "dsh-vision-bridge-zh",
  "version": "0.4.6",
  "description": "图片理解桥接(dsh-vision-bridge 的中文界面分支):聊天里的图片交给你选定的视觉模型描述,非视觉模型也能\"看图\"。Fork of @goodandready/dsh-vision-bridge 0.4.5 (MIT) with a Chinese UI; the wire, routes and config file are unchanged.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WZZNNE/DSH-CyberWorkStation.git",
    "directory": "plugins/dsh-vision-bridge-zh"
  },
  "homepage": "https://github.com/WZZNNE/DSH-CyberWorkStation#readme",
  "bugs": {
    "url": "https://github.com/WZZNNE/DSH-CyberWorkStation/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "vision",
    "vision-model",
    "image",
    "multimodal",
    "text-to-image",
    "dsh-cyberworkstation"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
