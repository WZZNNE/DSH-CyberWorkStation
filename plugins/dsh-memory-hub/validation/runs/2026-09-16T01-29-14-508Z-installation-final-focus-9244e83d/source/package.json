{
  "name": "dsh-memory-hub",
  "version": "1.1.0-rc.1",
  "suiteDefault": false,
  "description": "Local-first agent memory with a SQLite authority, multilingual retrieval, DSH plugin, MCP server and reusable library.",
  "type": "module",
  "main": "./lib/dsh.js",
  "exports": {
    ".": "./lib/dsh.js",
    "./core": "./lib/core.js",
    "./client": "./lib/client.js",
    "./service": "./lib/service.js",
    "./mcp": "./lib/mcp.js",
    "./intent": "./lib/intent.js",
    "./providers": "./lib/providers.js",
    "./semantic": "./lib/semantic.js",
    "./capture": "./lib/capture.js",
    "./generation": "./lib/generation.js",
    "./actions": "./lib/actions.js",
    "./operations": "./lib/operations.js",
    "./config": "./lib/config.js",
    "./package.json": "./package.json",
    "./mcp-modern": "./lib/mcp-modern.js",
    "./setup": "./lib/setup.js",
    "./spending": "./lib/spending.js",
    "./outbox": "./lib/outbox.js"
  },
  "bin": {
    "dsh-memory": "./bin/dsh-memory.js"
  },
  "files": [
    "lib",
    "bin",
    "web",
    "README.md",
    "USER-GUIDE.md",
    "API.md",
    "LIMITATIONS.md",
    "ARCHITECTURE.md",
    "VALIDATION.md",
    "EVALUATION.md",
    "EVALUATION-1.0.md",
    "DEPENDENCIES.md",
    "BILINGUAL.md",
    "CHANGELOG.md",
    "LICENSE",
    "cordis.patch.yml",
    "INSTALLATION-1.1.md",
    "MCP-COMPATIBILITY.md",
    "UPGRADE-OUTBOX.md",
    "UPGRADE-1.1.md"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "test": "node validation/record-run.mjs --label unit-suite -- node --test test/*.test.mjs",
    "start": "node bin/dsh-memory.js serve",
    "bundle:mcpb": "node validation/record-run.mjs --label mcpb-build -- node packaging/build-mcpb.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@modelcontextprotocol/client": "2.0.0"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
