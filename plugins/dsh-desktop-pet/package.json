{
  "name": "dsh-desktop-pet-cws",
  "version": "0.2.2",
  "description": "A desktop companion for DeepSeek Harness: its own persona, lorebook and multimodal API, a user profile distilled from the harness's own chat history, awareness of the running task, proactive chatter, reminders, voice, 8-24 frame sprite animations, screen reading and computer control behind a three-level permission, and a click-to-talk desktop window (WinForms sprite or Edge app window) next to the in-app floating pet.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./pet": {
      "default": "./lib/pet.js"
    },
    "./chat": {
      "default": "./lib/chat.js"
    },
    "./history": {
      "default": "./lib/history.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "host",
    "tools",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-home-paths": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WZZNNE/DSH-CyberWorkStation.git",
    "directory": "plugins/dsh-desktop-pet"
  },
  "homepage": "https://github.com/WZZNNE/DSH-CyberWorkStation#readme",
  "bugs": {
    "url": "https://github.com/WZZNNE/DSH-CyberWorkStation/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-cyberworkstation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dsh-cyberworkstation-kit": "^1.0.0"
  }
}
