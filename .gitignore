# Dependencies and build outputs
node_modules/
*.tsbuildinfo

# Upstream core cloned by setup.cmd when the bundled core/ is absent (never committed)
deepseek-harness/

# Everything local to this machine lives under .local/ and never ships:
# maintainer tests, dev notes, maintainer scripts, runtime logs, caches.
.local/

# Runtime state written by the launcher
launcher/skins/launcher/active.txt
launcher/skins/frontend/active.txt

# Community skins downloaded from the market (third-party artwork; converted from npm on the user's machine)
launcher/skins/frontend/*.css
!launcher/skins/frontend/cyberpunk-2077.css
!launcher/skins/frontend/night-city-holo.css

# User / AI-made launcher skins (local data): only the bundled skins below are committed
launcher/skins/launcher/*.css
!launcher/skins/launcher/cyberpunk-2077.css
!launcher/skins/launcher/default.css
!launcher/skins/launcher/night-city-holo.css

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# per-workspace uploads made by dsh-drop-files
.dsh-uploads/
